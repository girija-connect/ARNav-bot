<?xml version="1.0"?>
<package format="3">
  <name>arnav_rack</name>
  <version>0.1.0</version>
  <description>ARNAV rack handling: scan merger, LiDAR rack-leg detector, jack controller, pick/place docking servers.</description>
  <maintainer email="girija-connect13@gmail.com">ARNAV maintainer</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>arnav_interfaces</depend>
  <exec_depend>arnav_sim</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
